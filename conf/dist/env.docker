#
# Copy this file to the repository root as .env before running docker compose.
# Only AC_DB_PASSWORD is mandatory.
#

# Published images from the manual GitHub Actions workflow.
WORLD_IMAGE=
AUTH_IMAGE=

# External inputs read by the init containers.
AC_EXTERNAL_INPUT_DIR=./env/user

# Persistent runtime directories on the host.
AC_ETC_DIR=./env/dist/etc
AC_LOGS_DIR=./env/dist/logs
AC_TEMP_DIR=./env/dist/temp
AC_DATA_DIR=./env/dist/data
AC_MYSQL_DATA_DIR=./var/mysql

# AzerothCore database account created automatically by db-prepare.
AC_DB_HOST=database
AC_DB_PORT=3306
AC_DB_USER=acore
AC_DB_PASSWORD=
AC_AUTH_DATABASE=acore_auth
AC_WORLD_DATABASE=acore_world
AC_CHARACTER_DATABASE=acore_characters
AC_PLAYERBOTS_DATABASE=acore_playerbots

# Network ports exposed to the host.
AC_AUTH_EXTERNAL_PORT=3724
AC_WORLD_EXTERNAL_PORT=8085
AC_SOAP_EXTERNAL_PORT=7878

# Realm record written into acore_auth.realmlist.
AC_REALM_ID=1
AC_REALM_NAME=AzerothCore
AC_REALM_ADDRESS=127.0.0.1
AC_REALM_LOCAL_ADDRESS=127.0.0.1
AC_REALM_LOCAL_SUBNET_MASK=255.255.255.0
AC_REALM_PORT=8085

# Set to 1 only when you explicitly want to re-import assets or databases.
AC_FORCE_DATA_IMPORT=0
# Container timezone for MySQL and runtime images.
AC_TIMEZONE=Asia/Shanghai
